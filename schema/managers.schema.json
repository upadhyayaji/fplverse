{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fplverse.example/schema/managers.schema.json",
  "title": "FPLVerse manager dataset",
  "type": "object",
  "required": ["season", "generated_at", "manager_count", "failures", "managers"],
  "properties": {
    "season": {"type": "string", "pattern": "^\\d{4}/\\d{2}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {"type": "string"},
    "league_id": {"type": ["integer", "null"], "minimum": 1},
    "manager_count": {"type": "integer", "minimum": 1},
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entry_id", "error"],
        "properties": {
          "entry_id": {"type": "integer", "minimum": 1},
          "error": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "demo": {"type": "boolean"},
    "managers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "team_name", "history"],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1},
          "team_name": {"type": "string", "minLength": 1},
          "joined_time": {"type": ["string", "null"]},
          "started_event": {"type": ["integer", "null"], "minimum": 1, "maximum": 38},
          "current_event": {"type": ["integer", "null"], "minimum": 1, "maximum": 38},
          "history": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["gameweek", "points", "total_points"],
              "properties": {
                "gameweek": {"type": "integer", "minimum": 1, "maximum": 38},
                "points": {"type": "integer", "minimum": 0},
                "total_points": {"type": "integer", "minimum": 0},
                "overall_rank": {"type": "integer", "minimum": 0},
                "gameweek_rank": {"type": "integer", "minimum": 0},
                "transfers": {"type": "integer", "minimum": 0},
                "transfer_cost": {"type": "integer", "minimum": 0},
                "points_on_bench": {"type": "integer", "minimum": 0},
                "team_value": {"type": "integer", "minimum": 0},
                "bank": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

